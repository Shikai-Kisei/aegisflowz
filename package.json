{
  "name": "aegisflow",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first firewall and observability proxy for AI agents",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @aegisflow/proxy",
    "start": "npm run start -w @aegisflow/proxy",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": { "node": ">=20" }
}
