# ==========================================
# AegisFlow (.gitignore)
# ==========================================

# Dependencies
node_modules/
jspm_packages/
web_modules/
.pnpm-store/

# Yarn
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build Outputs & Caches (Fastify, Next.js, TypeScript, Monorepo)
dist/
build/
.next/
out/
.output/
.cache/
.turbo/
.nx/cache
.nx/workspace-data
.nx/migrate-runs
*.tsbuildinfo
*.tgz

# Environment Variables & Secrets (CRITICAL - NEVER COMMIT)
.env
.env.*
!.env.example

# AegisFlow Local Data, SQLite Databases & AI Models
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal
.aegisflow/
data/
models/*.onnx

# Logs & Diagnostic Reports
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime Data & Caches
pids/
*.pid
*.seed
*.pid.lock
.npm
.eslintcache
.stylelintcache
.node_repl_history

# Test Coverage
coverage/
*.lcov
.nyc_output/
lib-cov/

# Python Examples (Optional for /examples folder)
__pycache__/
*.py[cod]
.venv/
venv/

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.vscode-test/
.idea/
*.swp
*.swo
