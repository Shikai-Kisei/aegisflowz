# Upstream provider base URL. Never take this from an incoming request.
AEGISFLOW_UPSTREAM_URL=https://api.openai.com
# Optional bearer token used for upstream requests; clients may also supply their own.
AEGISFLOW_API_KEY=
AEGISFLOW_HOST=127.0.0.1
AEGISFLOW_PORT=4318
AEGISFLOW_DB_PATH=.aegisflow/traces.sqlite
